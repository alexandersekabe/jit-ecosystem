{
  "name": "jit-ecosystem",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "supabase:start": "supabase start",
    "supabase:gen-types": "supabase gen types typescript --local > packages/supabase/types/supabase.ts"
  }
}